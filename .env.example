# Linklik - Çevresel Değişkenler Şablonu

# Sunucunun dinleyeceği port
PORT=8080

# SQLite veritabanı dosyasının kaydedileceği konum
DB_PATH=linklik.db

# JWT token imzalamak için kullanılacak gizli anahtar.
# Güvenlik: min 32 byte (256 bit). Üretimde mutlaka güçlü rastgele bir değer kullanın:
#   openssl rand -hex 32
JWT_SECRET=canli_ortamda_bunu_guvenli_ve_uzun_bir_rastgele_metinle_degistirin_en_az_32_bayt

# Kısaltılmış linklerin ön eki (Kullanıcılara bu adres üzerinden linkler sunulur)
BASE_URL=http://localhost:8080

# Çerez Secure bayrağı: HTTPS (veya HTTPS sonlandırmalı reverse-proxy) arkasında çalışıyorsanız true ayarlayın.
COOKIE_SECURE=false

# CORS izin verilen kökenler (virgülle ayrılmış). Boşsa yalnızca BaseURL kökeni kullanılır.
# Örn: https://linklik.example.com,https://app.example.com
ALLOWED_ORIGINS=

# (Opsiyonel) TLS sertifikaları: ayarlıysa sunucu HTTPS başlatır
TLS_CERT_PATH=
TLS_KEY_PATH=